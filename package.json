{
  "name": "git-xlx",
  "displayName": "Git XLX",
  "description": "Git 工具集：仓库集——在【源代码管理】自建一栏，勾选即打开仓库、取消即关闭，只保留日常要看的那几个",
  "version": "1.0.1",
  "publisher": "xiaolinxin",
  "icon": "icon.png",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "scm",
    "repositories",
    "repo sets",
    "source control",
    "workspace",
    "仓库集"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiao-linxin/vscode-git-xlx"
  },
  "bugs": {
    "url": "https://github.com/xiao-linxin/vscode-git-xlx/issues"
  },
  "homepage": "https://github.com/xiao-linxin/vscode-git-xlx#readme",
  "contributes": {
    "commands": [
      {
        "command": "gitXlx.save",
        "title": "保存当前为集合",
        "category": "Git XLX",
        "icon": "$(bookmark)"
      },
      {
        "command": "gitXlx.apply",
        "title": "套用集合",
        "category": "Git XLX",
        "icon": "$(checklist)"
      },
      {
        "command": "gitXlx.openAll",
        "title": "打开全部仓库",
        "category": "Git XLX",
        "icon": "$(expand-all)"
      },
      {
        "command": "gitXlx.closeAll",
        "title": "关闭全部仓库",
        "category": "Git XLX",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitXlx.scan",
        "title": "扫描仓库",
        "category": "Git XLX",
        "icon": "$(search)"
      },
      {
        "command": "gitXlx.refresh",
        "title": "刷新",
        "category": "Git XLX",
        "icon": "$(refresh)"
      },
      {
        "command": "gitXlx.openConfig",
        "title": "打开配置文件",
        "category": "Git XLX",
        "icon": "$(json)"
      },
      {
        "command": "gitXlx.openSettings",
        "title": "打开设置",
        "category": "Git XLX",
        "icon": "$(gear)"
      },
      {
        "command": "gitXlx.menu",
        "title": "仓库集菜单",
        "category": "Git XLX",
        "icon": "$(bookmark)"
      },
      {
        "command": "gitXlx.groupCloseAll",
        "title": "取消该节点全部选中",
        "category": "Git XLX"
      },
      {
        "command": "gitXlx.groupOpenAll",
        "title": "选中该节点全部仓库",
        "category": "Git XLX"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitXlx.repoSets",
          "name": "仓库集",
          "contextualTitle": "Git XLX"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitXlx.save",
          "when": "view == gitXlx.repoSets",
          "group": "navigation@1"
        },
        {
          "command": "gitXlx.closeAll",
          "when": "view == gitXlx.repoSets",
          "group": "navigation@2"
        },
        {
          "command": "gitXlx.apply",
          "when": "view == gitXlx.repoSets",
          "group": "navigation@3"
        },
        {
          "command": "gitXlx.scan",
          "when": "view == gitXlx.repoSets",
          "group": "1_tools@1"
        },
        {
          "command": "gitXlx.refresh",
          "when": "view == gitXlx.repoSets",
          "group": "1_tools@2"
        },
        {
          "command": "gitXlx.openConfig",
          "when": "view == gitXlx.repoSets",
          "group": "2_cfg@1"
        },
        {
          "command": "gitXlx.openSettings",
          "when": "view == gitXlx.repoSets",
          "group": "2_cfg@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitXlx.openAll",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitXlx.closeAll",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "view/item/context": [
        {
          "command": "gitXlx.groupOpenAll",
          "when": "view == gitXlx.repoSets && viewItem == gitXlx.group",
          "group": "1_gitxlx@1"
        },
        {
          "command": "gitXlx.groupCloseAll",
          "when": "view == gitXlx.repoSets && viewItem == gitXlx.group",
          "group": "1_gitxlx@2"
        }
      ]
    },
    "configuration": {
      "title": "Git XLX",
      "properties": {
        "gitXlx.configPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "仓库集数据文件路径。留空＝`<窗口根>/.vscode/git-xlx.json`；支持 `~` 与 `${workspaceFolder}`。"
        },
        "gitXlx.restoreOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "启动时自动套用 `activeSet`（关闭不在集合里的仓库）。"
        },
        "gitXlx.alignDelay": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "scope": "window",
          "markdownDescription": "仓库扫描静默多少秒后开始对齐，避免把\"还没扫到\"的仓库误判为不该开。"
        },
        "gitXlx.newRepoPolicy": {
          "type": "string",
          "enum": [
            "keep",
            "close"
          ],
          "default": "keep",
          "scope": "window",
          "markdownDescription": "发现不在集合里的新仓库时：`keep` 保持打开；`close` 自动关闭。"
        },
        "gitXlx.confirmBeforeClose": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "批量关闭超过 3 个仓库前弹确认。"
        }
      }
    },
    "viewsWelcome": []
  },
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vsix": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
